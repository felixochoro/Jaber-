# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=schoolconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/schoolconnect
SYNC_DATABASE_URL=postgresql://postgres:changeme@localhost:5432/schoolconnect
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=super-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
ENVIRONMENT=development

# ── API Keys ─────────────────────────────────────────────────────────────────
# Privileged API key for write/export endpoints (comma-separated for multiple)
API_KEYS=dev-key-1234

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Get your Mapbox token at https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_APP_NAME=SchoolConnect Atlas

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
